# Copy to .env and fill in. Get a token from https://api.pixellab.ai/mcp
# while logged into the PixelLab account.
#
# .mcp.json reads this so the token is never committed. If it is unset, the
# pixellab MCP server sends an unexpanded ${PIXELLAB_API_KEY} and every call
# fails with "401: Invalid API token".
PIXELLAB_API_KEY=
